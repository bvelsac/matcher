# Copy this file to .env and fill in your values. Never commit .env.

# "production" (MySQL, default), "development" (local SQLite file) or "testing"
APP_CONFIG=production

# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL connection
MYSQL_USER=interpreter_user
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=interpreter_system

# Alternatively, a full SQLAlchemy URL (overrides the MYSQL_* settings):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/interpreter_system?charset=utf8mb4

# An editing lock nobody released is dropped after this many hours
SYSTEM_LOCK_TIMEOUT_HOURS=4
