# Copy this file to .env and fill in your values. Never commit .env.

# "production" (default), "development" (local SQLite file, fixed user) or "testing"
APP_CONFIG=production

# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The SQLite database. Default in production: /data/pdc.db (the volume of the container).
# DATABASE_URL=sqlite:////data/pdc.db

# Authelia user ids that may change data, separated by commas. Interim, until spic gives
# PDC its list of invoerders and beheerders; everyone else Authelia lets in can only read.
PDC_EDITORS=

# Where "Log out" leads (Authelia)
# PDC_LOGOUT_URL=https://login.infracriv.net/logout

# Development without Authelia: a fixed user
# PDC_AUTH_MODE=dev
# PDC_DEV_USER=developer
# PDC_DEV_NAME=Developer
