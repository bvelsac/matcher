{
  // A trial server in GitHub Codespaces: PDC in development mode (no Authelia, everyone is
  // signed in as the editor "developer") with fictitious sample data. Never real data here.
  "name": "PDC trial",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "APP_CONFIG": "development",
    "DATABASE_URL": "sqlite:////workspaces/pdc_trial.db",
    "TZ": "Europe/Brussels"
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  // Runs in a terminal of its own and stays in the foreground, so Codespaces does not stop it.
  "postAttachCommand": "sh .devcontainer/start.sh",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {"label": "PDC", "onAutoForward": "openBrowser"}
  }
}
